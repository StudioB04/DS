{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "$uikit": ["../src/components/uikit"],
      "$uikit/*": ["../src/components/uikit/*"],
      "$utils": ["../src/utils"],
      "$utils/*": ["../src/utils/*"],
      "$/*": ["../src/*"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
